---
// The download call to action, from the release read at build time
// (src/data/release.ts). No release with app assets yet: watch the
// releases and install the CLI, which works today. Never a dead button.
import type { AppRelease } from "../data/release.ts";
import { formatSize } from "../data/release.ts";
import { site } from "../data/site.ts";
import Cmd from "./Cmd.astro";

interface Props {
  release: AppRelease | null;
}
const { release } = Astro.props;
const linux = release?.appImage ?? release?.deb;
---

<div class="cta">
  {
    release ? (
      <>
        <div class="row">
          {release.mac && (
            <a class="btn btn-primary" href={release.mac.url}>
              Download for macOS <small>{formatSize(release.mac.size)}</small>
            </a>
          )}
          {linux && (
            <a class="btn btn-ghost" href={linux.url}>
              Linux <small>{linux.name.endsWith(".deb") ? ".deb" : "AppImage"}</small>
            </a>
          )}
        </div>
        <Cmd command={site.brewCask} class="cta-cmd" />
        <p class="meta">
          Version {release.version}. <a href={release.url}>Release notes</a>
        </p>
      </>
    ) : (
      <>
        <p class="meta">The desktop app ships with v1. The CLI works today:</p>
        <div class="row">
          <a class="btn btn-primary" href={site.releases}>
            Watch releases
          </a>
          <Cmd command={site.goInstall} class="cta-cmd" />
        </div>
      </>
    )
  }
</div>

<style>
  .cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    width: 100%;
    gap: 14px;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px;
    width: 100%;
  }

  .row :global(.cta-cmd) {
    width: min(500px, 100%);
  }

  .cta > :global(.cta-cmd) {
    width: min(420px, 100%);
  }
</style>
