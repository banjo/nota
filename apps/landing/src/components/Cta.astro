---
// The download call to action, from the release read at build time
// (src/data/release.ts). No release with app assets yet: watch the
// releases. Brew is the install story; the sign-in goes to the web app.
import type { AppRelease } from "../data/release.ts";
import { formatSize } from "../data/release.ts";
import { site } from "../data/site.ts";
import Cmd from "./Cmd.astro";

interface Props {
  release: AppRelease | null;
}
const { release } = Astro.props;
const linux = release?.appImage ?? release?.deb;
---

<div class="cta">
  <div class="row">
    {
      release?.mac ? (
        <a class="btn btn-primary" href={release.mac.url}>
          Download for Mac <small>{formatSize(release.mac.size)}</small>
        </a>
      ) : (
        <a class="btn btn-primary" href={release?.url ?? site.releases}>
          {release ? "Download" : "Watch releases"}
        </a>
      )
    }
    <a class="btn btn-ghost" href={site.signIn}>Sign in online</a>
  </div>
  <Cmd command={site.brewCask} class="cta-cmd" />
  <p class="meta">
    {
      release ? (
        <>
          Nota {release.version} for Apple silicon, macOS 12+.{" "}
          {linux && (
            <>
              <a href={linux.url}>{linux.name.endsWith(".deb") ? "Linux .deb" : "Linux AppImage"}</a>,{" "}
            </>
          )}
          <a href={release.url}>release notes</a>.
        </>
      ) : (
        <>The Mac app lands with the first release (Apple silicon, macOS 12+). Watch it on GitHub.</>
      )
    }
  </p>
</div>

<style>
  .cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    width: 100%;
    gap: 14px;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px;
    width: 100%;
  }

  .row :global(.cta-cmd) {
    width: min(500px, 100%);
  }

  .cta > :global(.cta-cmd) {
    width: min(420px, 100%);
  }

  .meta {
    margin: 0;
    max-width: 34em;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: balance;
  }

  .meta a {
    color: inherit;
    text-underline-offset: 3px;
  }

  @media (max-width: 440px) {
    .cta :global(.cta-cmd code) {
      font-size: 12.5px;
    }
  }
</style>
