---
import { site } from "../data/site.ts";
import GitHubIcon from "./GitHubIcon.astro";
---

<header class="wrap top">
  <a class="brand" href="/" aria-label="Nota, home"
    ><svg class="lockup" viewBox="0 0 216 64" width="88" height="26" aria-hidden="true"
      ><g class="mark" transform="scale(2)"
        ><path d="M7.5 25.5V8.5L20.5 24" fill="none" stroke="currentColor" stroke-width="5.2" stroke-linecap="round" stroke-linejoin="round"></path><path
          d="M23.04 24.58L27.58 4.62A1 1 0 0 0 25.67 4.03L18.09 23.04A2.6 2.6 0 1 0 23.04 24.58Z"
          fill="currentColor"></path></g
      ><path
        transform="translate(78 7) scale(.8)"
        d="M4 20V60M4 41a17 17 0 0 1 34 0V60M53 41a17 17 0 1 0 34 0a17 17 0 1 0-34 0M107 8V48a12 12 0 0 0 12 12h3M98 24H121M132 41a17 17 0 1 0 34 0a17 17 0 1 0-34 0M166 20V60"
        fill="none"
        stroke="currentColor"
        stroke-width="8"></path></svg
    ></a
  >
  <nav class="top-links" aria-label="Elsewhere">
    <a class="signin" href={site.signIn}>Sign in</a>
    <a class="icon-btn" href={site.repo} aria-label="Nota on GitHub"><GitHubIcon /></a>
    <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch to dark mode">
      <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"
        ><circle cx="12" cy="12" r="4"></circle><path
          d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg
      >
      <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
        ><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg
      >
    </button>
  </nav>
</header>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
  }

  /* The lockup from assets/brand/lockup.svg, inline so the mark takes
     the ink and the wordmark the text colour in either mode. */
  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--foreground);
    text-decoration: none;
  }

  .lockup {
    display: block;
  }

  .mark {
    color: var(--ink);
  }

  .signin {
    margin-right: 6px;
    padding: 8px 12px;
    border-radius: 10px;
    font-size: 14.5px;
    font-weight: 550;
    color: var(--text);
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .signin:hover {
      background: var(--hover);
    }
  }

  .top-links {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition:
      background-color 150ms ease,
      color 150ms ease,
      transform 160ms var(--ease-out);
  }

  /* The toggle needs the script; data-js is set before the first paint. */
  :global(:root:not([data-js])) [data-theme-toggle] {
    display: none;
  }

  .icon-btn:active {
    transform: scale(0.96);
  }

  .icon-btn svg {
    width: 18px;
    height: 18px;
  }

  /* The icon shows the mode you get by pressing it. */
  .moon,
  :global(:root[data-mode="dark"]) .sun {
    display: none;
  }

  :global(:root[data-mode="dark"]) .moon {
    display: block;
  }

  @media (hover: hover) and (pointer: fine) {
    .icon-btn:hover {
      background: var(--hover);
      color: var(--foreground);
    }
  }
</style>
