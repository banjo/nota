---
import type { AppRelease } from "../data/release.ts";
import { agentCommands, agentPrompt } from "../data/site.ts";

interface Props {
  release: AppRelease | null;
}
const { release } = Astro.props;
const released = Boolean(release?.mac);

const icon = (d: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;

const ways = [
  { name: "Desktop", text: "Mac app, Linux", icon: icon('<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>') },
  { name: "Web", text: "Any browser", icon: icon('<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.7 5.6 3.7 9s-1.2 6.4-3.7 9M12 3c-2.5 2.6-3.7 5.6-3.7 9s1.2 6.4 3.7 9"/>') },
  { name: "CLI", text: "nota ls --json", mono: true, icon: icon('<path d="M5 7l5 5-5 5M12 17h7"/>') },
  { name: "Agents", text: "13 MCP tools", icon: icon('<path d="M12 3v3M5 8h14v10a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2zM9 13h.01M15 13h.01"/>') },
];
---

<section class="wrap section everywhere" aria-labelledby="ways-title">
  <h2 class="sec-title" id="ways-title">One vault, four ways in.</h2>
  <div class="grid">
    <ul class="ways">
      {
        ways.map((w) => (
          <li>
            <span class="ic" set:html={w.icon} />
            <b>{w.name}</b>
            {w.mono ? <code>{w.text}</code> : <span>{w.text}</span>}
          </li>
        ))
      }
    </ul>

    <div class="handoff">
      <div class="head">
        <h3>Hand this to your agent.</h3>
        <button class="copy" type="button" data-copy data-copy-from="p-agent">Copy</button>
      </div>
      <div class="tabs" role="tablist" aria-label="What to paste">
        <button type="button" role="tab" aria-selected="true" aria-controls="p-agent" id="t-agent">Prompt</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="p-cmd" id="t-cmd" tabindex="-1">Commands</button>
      </div>
      <pre class="panel" role="tabpanel" id="p-agent" aria-labelledby="t-agent">{agentPrompt(released)}</pre>
      <pre class="panel" role="tabpanel" id="p-cmd" aria-labelledby="t-cmd" hidden>{agentCommands(released)}</pre>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 24px 40px;
    margin-top: 40px;
    align-items: start;
  }

  .ways {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    padding: 0;
    list-style: none;
    border-radius: 14px;
    box-shadow: 0 0 0 1px var(--hairline) inset;
  }

  .ways li {
    display: grid;
    gap: 2px;
    padding: 22px 22px 24px;
  }

  .ways li:nth-child(odd) {
    border-right: 1px solid var(--hairline);
  }

  .ways li:nth-child(-n + 2) {
    border-bottom: 1px solid var(--hairline);
  }

  .ic {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin-bottom: 14px;
    border-radius: 9px;
    background: var(--ink-soft);
    color: var(--ink-strong);
  }

  .ic :global(svg) {
    width: 19px;
    height: 19px;
  }

  .ways b {
    font-size: 17px;
    font-weight: 650;
    color: var(--foreground);
  }

  .ways span,
  .ways code {
    font-size: 14.5px;
    color: var(--muted);
  }

  .ways code {
    font-size: 13px;
  }

  .handoff {
    border-radius: 14px;
    background: var(--background);
    box-shadow: var(--shadow-card);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 10px 0 20px;
  }

  h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 650;
  }

  .tabs {
    display: flex;
    gap: 4px;
    padding: 10px 14px 10px;
    border-bottom: 1px solid var(--divider);
  }

  [role="tab"] {
    padding: 6px 12px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    font: 600 13px var(--sans);
    cursor: pointer;
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }

  [role="tab"][aria-selected="true"] {
    background: var(--chip);
    color: var(--foreground);
  }

  .panel {
    margin: 0;
    padding: 16px 20px 20px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--text-soft);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  /* No script: no tabs, both panels. */
  :global(:root:not([data-js])) .tabs {
    display: none;
  }
  :global(:root:not([data-js])) .panel[hidden] {
    display: block;
    border-top: 1px solid var(--divider);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 420px) {
    .ways li {
      padding: 18px 16px 20px;
    }
  }
</style>
