---
import type { AppRelease } from "../data/release.ts";
import { diff } from "../scripts/frames.ts";
import Cta from "./Cta.astro";

interface Props {
  release: AppRelease | null;
}
const { release } = Astro.props;

const check = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7"/></svg>`;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap intro">
    <h1 id="hero-title">Your notes are files.</h1>
    <p class="lead">Local Markdown notes in a small Go app for desktop and web, synced through your own server.</p>
    <Cta release={release} />
  </div>

  <figure class="stage" data-hero>
    <div class="split" aria-hidden="true">
      <div class="pane term">
        <div class="pane-head">
          <div class="dots"><i></i><i></i><i></i></div>
          <span>~/Notes</span>
        </div>
        <pre class="screen" data-h="screen" set:html={diff()} />
      </div>
      <div class="pane app" data-h="app">
        <div class="pane-head">
          <span>Acme / <b>Weekly sync</b></span>
          <span class="sync" data-h="sync"><i></i><span data-h="sync-text">Up to date</span></span>
        </div>
        <div class="note">
          <h2>Weekly sync</h2>
          <div class="props">
            <span>Tags</span>
            <span class="tags"><span class="chip">#acme</span><span class="chip">#meeting</span></span>
            <span>Status</span>
            <span class="status" data-h="status" data-done><i></i><span data-h="status-text">Done</span></span>
          </div>
          <h3>Decisions</h3>
          <ul>
            <li class="bullet">Ship the beta on the 14th</li>
            <li class="bullet">Keep the free tier</li>
          </ul>
          <h3>Todo</h3>
          <ul>
            <li data-h="mia" data-checked>
              <span class="box" data-h="box" set:html={check} /><span class="txt">Mia: draft release notes</span>
            </li>
            <li data-h="sam">
              <span class="box" set:html={check} /><span class="txt">Sam: book the venue</span>
            </li>
          </ul>
        </div>
        <svg class="pointer" data-h="pointer" viewBox="0 0 18 22"
          ><path
            d="M1 1l15 11-6.5 1.2L13 20l-3 1.4-3.4-6.9L1 18z"
            fill="#fff"
            stroke="#1d1f24"
            stroke-width="1.3"
            stroke-linejoin="round"></path></svg
        >
      </div>
    </div>
    <figcaption class="file-tag">
      <span class="visually-hidden">One file, edited in vim and in Nota, then read with git diff:</span>
      ~/Notes/Acme/Weekly sync.md
    </figcaption>
  </figure>
</section>

<style>
  .hero {
    padding-top: clamp(36px, 5.5vw, 80px);
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: clamp(50px, 8.6vw, 118px);
    line-height: 0.96;
    font-weight: 700;
    /* Tight, but "Your notes" must not touch at display size. */
    letter-spacing: -0.026em;
    word-spacing: 0.06em;
  }

  .lead {
    max-width: 29em;
    margin: 24px 0 30px;
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.5;
    color: var(--muted);
    text-wrap: balance;
  }

  /* One file, two programs */
  .stage {
    width: min(1240px, 100% - 40px);
    margin: clamp(44px, 5vw, 64px) auto 0;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: 500px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow-window);
  }

  .pane {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .pane-head {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 16px;
    font-size: 12.5px;
  }

  .term {
    background: var(--term-bg);
    color: var(--term-fg);
  }

  .term .pane-head {
    color: var(--term-dim);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .term .dots i {
    background: rgba(255, 255, 255, 0.14);
  }

  .screen {
    flex: 1;
    margin: 0;
    padding: 16px 20px;
    overflow: hidden;
    font: 13.5px/1.62 var(--mono);
    white-space: pre-wrap;
  }

  .screen :global(.dim) {
    color: var(--term-dim);
  }
  .screen :global(.key),
  .screen :global(.prompt) {
    color: var(--term-key);
  }
  .screen :global(.h) {
    color: var(--term-head);
    font-weight: 600;
  }
  .screen :global(.add) {
    color: var(--term-add);
  }
  .screen :global(.del) {
    color: var(--term-del);
  }
  .screen :global(.vimline) {
    display: block;
    margin: 0 -20px;
    padding: 0 20px;
    background: rgba(255, 255, 255, 0.06);
  }
  .screen :global(.tcaret) {
    display: inline-block;
    width: 0.6em;
    height: 1.15em;
    vertical-align: -0.2em;
    background: var(--term-fg);
    animation: blink 1s steps(1) infinite;
  }

  .app {
    background: var(--background);
    border-left: 1px solid var(--hairline);
  }

  .app .pane-head {
    justify-content: space-between;
    color: var(--muted);
    border-bottom: 1px solid var(--hairline);
    background: var(--sidebar);
  }

  .app .pane-head b {
    font-weight: 500;
    color: var(--text);
  }

  .sync {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    transition: color 200ms ease;
  }

  .sync i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--hairline);
    transition: background-color 200ms ease;
  }

  .sync[data-on] {
    color: var(--ink-strong);
  }

  .sync[data-on] i {
    background: var(--ink);
  }

  .note {
    flex: 1;
    width: min(440px, 100% - 48px);
    margin: 28px auto 0;
    font-size: 15px;
    color: var(--text);
  }

  .note h2 {
    margin: 0 0 14px;
    font-size: 30px;
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.022em;
  }

  .props {
    display: grid;
    grid-template-columns: 76px 1fr;
    gap: 8px 0;
    align-items: center;
    padding-bottom: 14px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--divider);
    font-size: 13.5px;
    color: var(--muted);
  }

  .tags {
    display: flex;
    gap: 6px;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text-soft);
  }

  .status i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--warning);
    transition: background-color 200ms ease;
  }

  .status[data-done] i {
    background: var(--success);
  }

  .note h3 {
    margin: 14px 0 4px;
    font-size: 15px;
    font-weight: 650;
  }

  .note ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .note li {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 28px;
    border-radius: 6px;
    transition:
      opacity 260ms var(--ease-out),
      transform 260ms var(--ease-out),
      background-color 900ms ease;
  }

  .note li.bullet::before {
    content: "";
    width: 5px;
    height: 5px;
    margin: 0 4px 0 6px;
    border-radius: 50%;
    background: var(--faint);
  }

  .note li[data-hidden] {
    opacity: 0;
    transform: translateY(-4px);
  }

  .note li[data-flash] {
    background: var(--ink-soft);
    transition: none;
  }

  .box {
    flex: none;
    display: grid;
    place-items: center;
    width: 17px;
    height: 17px;
    margin-left: 2px;
    border-radius: 5px;
    box-shadow: 0 0 0 1.5px var(--faint) inset;
    transition:
      background-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms var(--ease-out);
  }

  .box :global(svg) {
    width: 12px;
    height: 12px;
    color: var(--ink-foreground);
    opacity: 0;
    transition: opacity 120ms ease;
  }

  li[data-checked] .box {
    background: var(--ink);
    box-shadow: none;
  }

  li[data-checked] .box :global(svg) {
    opacity: 1;
  }

  li[data-checked] .txt {
    color: var(--muted);
    text-decoration: line-through;
  }

  .box[data-press] {
    transform: scale(0.85);
  }

  .pointer {
    position: absolute;
    z-index: 3;
    top: 0;
    left: 0;
    width: 18px;
    height: 22px;
    opacity: 0;
    transition:
      transform 700ms var(--ease-in-out),
      opacity 200ms ease;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.3));
  }

  .file-tag {
    margin-top: 16px;
    text-align: center;
    font: 13px var(--mono);
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
      height: auto;
    }
    .pane {
      height: 330px;
    }
    .app {
      border-left: 0;
      border-top: 1px solid var(--hairline);
    }
  }

  @media (max-width: 520px) {
    .stage {
      width: calc(100% - 24px);
    }
    .screen {
      padding: 12px 14px;
      font-size: 11.5px;
    }
    .screen :global(.vimline) {
      margin: 0 -14px;
      padding: 0 14px;
    }
    .pane {
      height: 300px;
    }
    .app.pane {
      height: 372px;
    }
    .note {
      margin-top: 18px;
      font-size: 14px;
    }
    .note h2 {
      font-size: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .screen :global(.tcaret) {
      animation: none;
    }
  }
</style>
